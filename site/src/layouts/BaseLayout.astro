---
interface Props {
  title?: string;
  description?: string;
  heroImage?: string;
}

const {
  title = 'Mohan Kumar — Design, Software, Products',
  description = 'Mohan Kumar — design, software and products.',
  heroImage,
} = Astro.props;

import '@/styles/site.css';
import { ClientRouter } from 'astro:transitions';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('mohanverse-theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        // Private browsing or blocked storage falls back to system preference.
      }
    </script>
    {heroImage && <link rel="preload" as="image" href={heroImage} type="image/webp" fetchpriority="high" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Geist:wght@400;500;600;700;800&family=Matemasie&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Geist:wght@400;500;600;700;800&family=Matemasie&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Geist:wght@400;500;600;700;800&family=Matemasie&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script src="@/scripts/site.js"></script>
  </body>
</html>
