---
import type { CollectionEntry } from 'astro:content';

interface Props {
  build: CollectionEntry<'builds'>;
  variant?: 'default' | 'artifact';
}

const { build, variant = 'default' } = Astro.props;
const { data } = build;
const landscapeSrcset = data.coverLandscapeSmall
  ? `${data.coverLandscapeSmall} 720w, ${data.cover} 1440w`
  : undefined;
const portraitSrcset = data.coverPortrait && data.coverPortraitSmall
  ? `${data.coverPortraitSmall} 480w, ${data.coverPortrait} 720w`
  : data.coverPortrait;
const imageSizes = '(max-width: 34rem) 100vw, (max-width: 48rem) 50vw, (max-width: 104rem) 33vw, 25vw';
---

<article class={`build-card${variant === 'artifact' ? ' build-card--artifact' : ''}`}>
  <a
    class="build-card__link"
    href={'/builds/' + data.slug + '/'}
    aria-labelledby={'build-' + data.slug}
  >
    <div class="build-card__capture" transition:name={'build-cover-' + data.slug}>
      <picture>
        {data.coverPortrait && <source media="(max-width: 48rem)" srcset={portraitSrcset} sizes={imageSizes} width="720" height="960" />}
        <img
          src={data.cover}
          srcset={landscapeSrcset}
          sizes={imageSizes}
          alt={data.title + ' demo capture'}
          width="1440"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
    <div class="build-card__body">
      <div class="build-card__meta">
        <span>{data.category}</span>
        <span>{data.status} · {data.year}</span>
      </div>
      <h3 id={'build-' + data.slug}>{data.title}</h3>
      <p>{data.summary}</p>
      <span class="build-card__action">View build <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>

<style>
  :where(.build-card) {
    min-width: 0;
  }

  .build-card__link {
    --state-lift: 0rem;
    display: block;
    color: inherit;
    text-decoration: none;
    transform: translateY(var(--state-lift));
    transition: transform var(--motion-base) var(--motion-ease);
  }

  .build-card__capture {
    position: relative;
    overflow: visible;
    clip-path: inset(0 round var(--radius-sm));
    background: var(--interactive-surface);
    transition: clip-path var(--motion-slow) var(--motion-ease);
  }

  .build-card__capture::after {
    position: absolute;
    inset: 0;
    border: var(--border-thin) solid color-mix(in oklch, var(--copy) 18%, transparent);
    content: "";
    pointer-events: none;
  }

  .build-card__capture picture {
    display: block;
    width: 100%;
  }

  .build-card__capture img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    transition: transform var(--motion-slow) var(--motion-ease), filter var(--motion-base) var(--motion-ease);
  }

  .build-card__link:is(:hover, :focus-visible) {
    --state-lift: -.3rem;
  }

  .build-card__link:is(:hover, :focus-visible) .build-card__capture {
    z-index: var(--z-content);
      clip-path: inset(calc(-12% - var(--border-thin)) round var(--radius-sm));
  }

  .build-card__link:is(:hover, :focus-visible) .build-card__capture img {
    filter: saturate(1.1);
    transform: scale(1.215);
  }

  .build-card__body {
    padding-top: var(--space-5);
  }

  .build-card__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--quiet-copy);
    font: 500 var(--type-meta-size)/1.25 var(--font-mono);
    letter-spacing: var(--tracking-roomy);
    text-transform: uppercase;
  }

  .build-card h3 {
    margin-top: var(--space-4);
    font-size: var(--type-subheading-size);
    line-height: .9;
  }

  .build-card p {
    max-inline-size: var(--container-sm);
    margin-top: var(--space-4);
    color: var(--quiet-copy);
  }

  .build-card__action {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
    color: inherit;
    font: 500 var(--type-label-size)/1 var(--font-mono);
    letter-spacing: var(--tracking-roomy);
    text-transform: uppercase;
  }

  @media (width <= 48rem) {
    .build-card__capture {
      aspect-ratio: 3 / 4;
      max-block-size: 24rem;
    }

    .build-card__capture picture,
    .build-card__capture img {
      height: 100%;
    }

    .build-card__capture img {
      object-fit: cover;
      object-position: top;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .build-card__link,
    .build-card__capture,
    .build-card__capture img {
      transition: none;
    }

    .build-card__link:is(:hover, :focus-visible) {
      --state-lift: 0rem;
    }

    .build-card__link:is(:hover, :focus-visible) .build-card__capture {
      clip-path: inset(0 round var(--radius-sm));
    }

    .build-card__link:is(:hover, :focus-visible) .build-card__capture img {
      filter: none;
      transform: none;
    }
  }
</style>
