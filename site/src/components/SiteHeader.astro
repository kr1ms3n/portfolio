  border-bottom-left-radius: 0;
}

.menu-overlay__sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

.theme-switch__track {
  display: block;
  width: 5rem;
  height: 1.5rem;
  padding: .2rem;
  border: var(--border-thin) solid var(--rule-strong);
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg in oklch, var(--canvas), var(--signal), var(--copy));
}

.theme-switch__track::after {
  display: block;
  width: 1rem;
  height: 1rem;
  border-radius: var(--radius-round);
  background: var(--signal);
  box-shadow: 0 0 0 1px var(--copy);
