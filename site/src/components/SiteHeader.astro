<style is="global">
.floating-menu {
  --menu-size: clamp(5.5rem, calc(5.5rem + (7.5rem - 5.5rem) * var(--fluid-progress)), 7.5rem);
  position: fixed;
  top: 0;
  left: 0;
  z-index: var(--z-floating);
  display: block;
  width: var(--menu-size);
  height: var(--menu-size);
  flex: 0 0 var(--menu-size);
  padding: 0;
  border: 0;
  background: 0 0;
  cursor: grab;
  touch-action: none;
  view-transition-name: menu-control;
  view-transition-class: menu-control;
  opacity: 0;
  transition: opacity var(--motion-fast) var(--motion-ease);
}

.floating-menu.is-ready {
  opacity: 1;
}

.floating-menu:focus-visible {
  outline: var(--border-strong) solid var(--signal);
  outline-offset: 3px;
}

.floating-menu:focus-visible .floating-menu__blob path {
  stroke: var(--copy);
  stroke-width: 2;
}

.floating-menu.is-dragging {
  cursor: grabbing;
}

.floating-menu.is-snapping {
  cursor: default;
  transition: left var(--motion-slow) var(--motion-ease), top var(--motion-slow) var(--motion-ease), opacity var(--motion-fast) var(--motion-ease);
}

.floating-menu__surface {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  background: 0 0;
  color: var(--on-signal);
}

.floating-menu__blob,
.floating-menu__content {
  grid-area: 1/1;
}

.floating-menu__blob {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.floating-menu__blob path {
  fill: var(--signal);
  stroke: var(--signal-edge);
  stroke-width: .8;
}

.floating-menu__content {
  z-index: var(--z-content);
  display: grid;
  place-content: center;
  gap: .45rem;
  padding: var(--space-6);
}

.floating-menu.is-whomp .floating-menu__surface {
  animation: menu-whomp var(--motion-base) var(--motion-ease);
}

.floating-menu.is-whomp .floating-menu__blob path {
  animation: menu-impact var(--motion-base) var(--motion-ease);
}

.floating-menu__icon {
