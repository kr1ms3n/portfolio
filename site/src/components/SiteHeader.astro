.menu-overlay__page-copy {
  display: grid;
  gap: .4rem;
  color: var(--quiet-copy);
}

.menu-overlay__page-copy small {
  color: inherit;
  font: 500 var(--menu-meta-size)/1 var(--font-mono);
  letter-spacing: var(--tracking-roomy);
}

.menu-overlay__page-copy strong {
