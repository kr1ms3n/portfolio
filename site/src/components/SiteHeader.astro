  min-width: 2.5rem;
  height: 1.4em;
  overflow: hidden;
  transition: transform var(--motion-base) var(--motion-ease);
}

.menu-overlay__item-marker::before {
  grid-area: 1 / 1;
  content: counter(menu-link, decimal-leading-zero);
  transition: opacity var(--motion-base) var(--motion-ease), transform var(--motion-base) var(--motion-ease);
}

.menu-overlay__branch-marker::after {
  grid-area: 1 / 1;
  content: "→";
  font-size: 1.4em;
  opacity: 0;
  transform: translateY(.45em);
  transition: opacity var(--motion-base) var(--motion-ease), transform var(--motion-base) var(--motion-ease);
}

.menu-overlay__links > a:hover .menu-overlay__item-marker,
.menu-overlay__links > a:focus-visible .menu-overlay__item-marker,
.menu-overlay__branch-trigger:hover .menu-overlay__item-marker,
.menu-overlay__branch-trigger:focus-visible .menu-overlay__item-marker,
.menu-overlay__branch-trigger[aria-expanded=true] .menu-overlay__item-marker {
  transform: translateX(-.2rem);
}

.menu-overlay__branch-trigger:hover .menu-overlay__item-marker::before,
.menu-overlay__branch-trigger:focus-visible .menu-overlay__item-marker::before,
.menu-overlay__branch-trigger[aria-expanded=true] .menu-overlay__item-marker::before {
  opacity: 0;
  transform: translateY(-.45em);
}

.menu-overlay__branch-trigger:hover .menu-overlay__branch-marker::after,
.menu-overlay__branch-trigger:focus-visible .menu-overlay__branch-marker::after,
.menu-overlay__branch-trigger[aria-expanded=true] .menu-overlay__branch-marker::after {
  opacity: 1;
  transform: translateY(0);
}

.menu-overlay__page-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-4);
  padding: .9rem .25rem;
  border: 0;
  border-bottom: var(--border-thin) solid color-mix(in oklch, var(--tone-mist) 28%, transparent);
  border-radius: 0;
  background: transparent;
  color: var(--surface-copy);
  font: 700 var(--menu-secondary-size)/1 var(--font-display);
  letter-spacing: var(--tracking-tight);
  text-decoration: none;
  transition: background-color var(--motion-base) var(--motion-ease), color var(--motion-base) var(--motion-ease);
}

.menu-overlay__page-link:hover,
.menu-overlay__page-link:focus-visible {
  background: color-mix(in oklch, var(--color-teal) 10%, transparent);
