  --menu-secondary-size: var(--type-subheading-size);
  --menu-ui-size: var(--type-label-size);
  --menu-meta-size: var(--type-meta-size);
  position: fixed;
  z-index: var(--z-overlay);
  inset: 0;
  display: grid;
  place-items: center;
  height: 100vh;
  height: 100dvh;
  padding: max(1rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
  overflow: hidden;
  overscroll-behavior: contain;
  background: color-mix(in oklch, var(--canvas) 20%, transparent);
  color: var(--surface-copy);
  transition: background-color var(--motion-slow) var(--motion-ease), color var(--motion-slow) var(--motion-ease), border-color var(--motion-slow) var(--motion-ease);
}

.menu-overlay[hidden] {
  display: none;
}

.menu-overlay__content {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  inline-size: min(75vw, var(--container-md));
  height: min(90dvh, 55rem);
  max-height: 100%;
  padding: var(--layout-panel);
  overflow: hidden;
  overflow-x: hidden;
  border: var(--border-thin) solid color-mix(in oklch, var(--tone-mist) 52%, transparent);
  border-radius: var(--radius-xl);
  background: radial-gradient(circle at 18% 8%, color-mix(in oklch, var(--tone-mist) 32%, transparent), transparent 35%), radial-gradient(circle at 82% 100%, color-mix(in oklch, var(--color-teal) 22%, transparent), transparent 48%), linear-gradient(145deg, color-mix(in oklch, var(--surface) 78%, transparent), color-mix(in oklch, var(--interactive-surface) 58%, transparent));
  box-shadow: inset 0 1px 0 color-mix(in oklch, var(--tone-mist) 68%, transparent), inset 0 -1.25rem 2.5rem color-mix(in oklch, var(--copy) 14%, transparent), 0 1.75rem 5rem color-mix(in oklch, var(--copy) 34%, transparent);
  -webkit-backdrop-filter: blur(2rem) saturate(155%);
  backdrop-filter: blur(2rem) saturate(155%);
  view-transition-name: none;
  view-transition-class: menu-control;
}

.menu-overlay__links {
  display: grid;
  flex: 1 1 auto;
  counter-reset: menu-link;
  gap: 0;
  margin: 0;
}

.menu-overlay__links > a,
.menu-overlay__branch-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-5);
  width: 100%;
  padding: var(--layout-inset) 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--surface-copy);
  font: 800 var(--menu-primary-size)/.9 var(--font-display);
  letter-spacing: var(--tracking-tight);
  text-align: left;
  transition: color var(--motion-base) var(--motion-ease);
}

.menu-overlay__links > a {
  text-decoration: none;
  counter-increment: menu-link;
}

.menu-overlay__links > :not(:first-child) {
