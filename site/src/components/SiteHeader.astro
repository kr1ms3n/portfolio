}

/* Keep focus visible without an outline bleeding beyond the menu surface. */
.menu-overlay :is(a, button):focus-visible {
  outline: 0;
  outline-offset: 0;
  box-shadow: inset 0 -2px var(--signal);
}

body.menu-open {
  overflow: hidden;
}

body.menu-open .floating-menu {
  opacity: 0;
  pointer-events: none;
  view-transition-name: none;
}

body.menu-open .menu-overlay__content {
  view-transition-name: menu-control;
}

@media (width <= 48rem) {
  .menu-overlay__content {
    inline-size: min(calc(100vw - 2rem), var(--container-md));
    height: min(82dvh, 40rem);
  }
}

@media (prefers-reduced-motion: reduce) {
  .theme-switch__track::after,
  .menu-overlay {
    transition: none;
  }

  .floating-menu.is-snapping {
