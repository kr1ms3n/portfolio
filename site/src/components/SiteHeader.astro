}

.menu-overlay__page-arrow {
  font: 500 var(--menu-ui-size)/1 var(--font-mono);
  letter-spacing: var(--tracking-roomy);
  transition: transform var(--motion-base) var(--motion-ease);
}

.menu-overlay__page-link:hover .menu-overlay__page-arrow,
.menu-overlay__page-link:focus-visible .menu-overlay__page-arrow {
  transform: translateX(-.2rem);
}

.menu-overlay__panel-viewport {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}

.menu-overlay__panel-track {
  position: relative;
  min-width: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.menu-overlay__panel {
  display: flex;
  position: absolute;
  inset: 0;
  flex-direction: column;
  min-width: 0;
  overflow-y: auto;
  overflow-x: hidden;
  box-sizing: border-box;
  backface-visibility: hidden;
  transform: translateX(100%);
  transition: transform var(--motion-slow) var(--motion-ease);
  will-change: transform;
  scrollbar-width: thin;
  scrollbar-color: color-mix(in oklch, var(--surface-copy) 42%, transparent) transparent;
}

.menu-overlay__panel::-webkit-scrollbar { width: .35rem; }
.menu-overlay__panel::-webkit-scrollbar-track { background: transparent; }
.menu-overlay__panel::-webkit-scrollbar-thumb {
  border: .1rem solid transparent;
  border-radius: var(--radius-pill);
  background: color-mix(in oklch, var(--surface-copy) 42%, transparent);
  background-clip: padding-box;
}

.menu-overlay__panel.is-before { transform: translateX(-100%); }
.menu-overlay__panel.is-active { transform: translateX(0); }
.menu-overlay__panel.is-after { transform: translateX(100%); }

.menu-overlay__branch-trigger {
  cursor: pointer;
  overflow: hidden;
  appearance: none;
  counter-increment: menu-link;
}

.menu-overlay__branch-back svg {
  width: 1.15rem;
  height: 1.15rem;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.5;
}

.menu-overlay__subhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  min-height: 3.75rem;
  border-bottom: var(--border-thin) solid color-mix(in oklch, var(--tone-mist) 34%, transparent);
  color: var(--quiet-copy);
}

.menu-overlay__subhead p {
  margin: 0;
  color: inherit;
}

.menu-overlay__branch-back {
  display: inline-flex;
  align-items: center;
  gap: .65rem;
  padding: .5rem 0;
  border: 0;
  background: transparent;
  color: var(--surface-copy);
  cursor: pointer;
  font: 500 var(--menu-ui-size)/1 var(--font-mono);
  letter-spacing: var(--tracking-roomy);
}

.menu-overlay__branch-back:hover,
.menu-overlay__branch-back:focus-visible {
