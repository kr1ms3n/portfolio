}

.menu-overlay__links > a:focus-visible,
.menu-overlay__links > a:hover,
.menu-overlay__branch-trigger:focus-visible,
.menu-overlay__branch-trigger:hover,
.menu-overlay__branch-trigger[aria-expanded=true] {
